# FraudGuard Environment Configuration Example
# Copy to .env and customize for your deployment

# API Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Authentication
JWT_SECRET_KEY=fraudguard_super_secure_jwt_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# Presentation Demo Credentials (Configurable)
DEMO_USERNAME=admin
DEMO_PASSWORD=FraudGuard@2026

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
