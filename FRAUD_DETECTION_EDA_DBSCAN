      "source": [
        "# ============================================\n",
        "# BLOCK 5: FRAUD FACTORS & CORRELATION\n",
        "# ============================================\n",
        "\n",
        "features = [\n",
        "    \"Transaction_Type\",\n",
        "    \"Channel\",\n",
        "    \"Device_Change\",\n",
        "    \"International_Transaction\"\n",
        "]\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
        "\n",
        "# --------------------------------------------\n",
        "# Fraud rate by important categorical features\n",
        "# --------------------------------------------\n",
        "\n",
        "fraud_rates = []\n",
        "\n",
        "for feature in features:\n",
        "\n",
        "    temp = df.groupby(feature)[\"Fraud_Label\"].mean() * 100\n",
        "    temp = temp.reset_index()\n",
        "\n",
        "    temp[\"Feature\"] = feature\n",
        "    temp[\"Category\"] = temp[feature].astype(str)\n",
        "    temp = temp[[\"Feature\", \"Category\", \"Fraud_Label\"]]\n",
        "\n",
        "    fraud_rates.append(temp)\n",
        "\n",
        "fraud_rates = pd.concat(fraud_rates)\n",
        "\n",
        "sns.barplot(\n",
        "    data=fraud_rates,\n",
        "    x=\"Category\",\n",
        "    y=\"Fraud_Label\",\n",
        "    hue=\"Feature\",\n",
        "    ax=axes[0]\n",
        ")\n",
        "\n",
        "axes[0].set_title(\"Fraud Rate by Important Features\")\n",
        "axes[0].set_xlabel(\"Category\")\n",
        "axes[0].set_ylabel(\"Fraud Rate (%)\")\n",
        "axes[0].tick_params(axis=\"x\", rotation=45)\n",
        "\n",
        "# --------------------------------------------\n",
        "# Correlation heatmap\n",
        "# --------------------------------------------\n",
        "\n",
        "corr = df.select_dtypes(include=np.number).corr()\n",
        "\n",
        "sns.heatmap(\n",
        "    corr,\n",
        "    annot=True,\n",
        "    fmt=\".2f\",\n",
        "    cmap=\"coolwarm\",\n",
        "    ax=axes[1]\n",
        ")\n",
        "\n",
        "axes[1].set_title(\"Correlation Heatmap\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
